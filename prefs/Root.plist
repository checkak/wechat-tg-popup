<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>弹窗动画</string>
	<key>items</key>
	<array>

		<!-- ============ 开关 ============ -->
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>总开关</string>
			<key>footerText</key><string>改完立即生效，不需要重启微信。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>启用弹窗</string>
			<key>key</key><string>enabled</string>
			<key>default</key><true/>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>免打扰会话不弹</string>
			<key>key</key><string>mutedSuppress</string>
			<key>default</key><true/>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>正在聊天时也弹</string>
			<key>key</key><string>showWhenInChat</string>
			<key>default</key><false/>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>触感反馈</string>
			<key>key</key><string>haptic</string>
			<key>default</key><true/>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>群聊显示「群名 · 发送人」</string>
			<key>key</key><string>showGroupName</string>
			<key>default</key><true/>
		</dict>

		<!-- ============ 尺寸 ============ -->
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>尺寸</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSliderCell</string>
			<key>label</key><string>卡片高度</string>
			<key>key</key><string>cardHeight</string>
			<key>default</key><real>64</real>
			<key>min</key><real>48</real>
			<key>max</key><real>96</real>
			<key>showValue</key><true/>
		</dict>
		<dict>
			<key>cell</key><string>PSSliderCell</string>
			<key>label</key><string>左右留白</string>
			<key>key</key><string>cardInset</string>
			<key>default</key><real>15</real>
			<key>min</key><real>6</real>
			<key>max</key><real>30</real>
			<key>showValue</key><true/>
		</dict>
		<dict>
			<key>cell</key><string>PSSliderCell</string>
			<key>label</key><string>圆角</string>
			<key>key</key><string>cardRadius</string>
			<key>default</key><real>20</real>
			<key>min</key><real>8</real>
			<key>max</key><real>32</real>
			<key>showValue</key><true/>
		</dict>
		<dict>
			<key>cell</key><string>PSSliderCell</string>
			<key>label</key><string>头像大小</string>
			<key>key</key><string>avatarSize</string>
			<key>default</key><real>40</real>
			<key>min</key><real>24</real>
			<key>max</key><real>56</real>
			<key>showValue</key><true/>
		</dict>
		<dict>
			<key>cell</key><string>PSSliderCell</string>
			<key>label</key><string>距顶部</string>
			<key>key</key><string>topMargin</string>
			<key>default</key><real>60</real>
			<key>min</key><real>20</real>
			<key>max</key><real>120</real>
			<key>showValue</key><true/>
		</dict>

		<!-- ============ 入场 ============ -->
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>入场动画（果冻）</string>
			<key>footerText</key><string>默认值是对着视频逐帧量出来的：阻尼 0.38 → 过冲 27%、峰值 170ms、稳定 600ms。阻尼越小白勺弹，「落下距离」是负值，越大越像从屏幕外砸进来。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSliderCell</string>
			<key>label</key><string>落下距离</string>
			<key>key</key><string>dropFrom</string>
			<key>default</key><real>-36</real>
			<key>min</key><real>-90</real>
			<key>max</key><real>-8</real>
			<key>showValue</key><true/>
		</dict>
		<dict>
			<key>cell</key><string>PSSliderCell</string>
			<key>label</key><string>起始缩放</string>
			<key>key</key><string>enterScale</string>
			<key>default</key><real>0.72</real>
			<key>min</key><real>0.5</real>
			<key>max</key><real>1</real>
			<key>showValue</key><true/>
		</dict>
		<dict>
			<key>cell</key><string>PSSliderCell</string>
			<key>label</key><string>动画时长</string>
			<key>key</key><string>enterDuration</string>
			<key>default</key><real>0.52</real>
			<key>min</key><real>0.2</real>
			<key>max</key><real>1</real>
			<key>showValue</key><true/>
		</dict>
		<dict>
			<key>cell</key><string>PSSliderCell</string>
			<key>label</key><string>阻尼比（越小越弹）</string>
			<key>key</key><string>enterDamping</string>
			<key>default</key><real>0.38</real>
			<key>min</key><real>0.2</real>
			<key>max</key><real>0.9</real>
			<key>showValue</key><true/>
		</dict>
		<dict>
			<key>cell</key><string>PSSliderCell</string>
			<key>label</key><string>初速度</string>
			<key>key</key><string>enterVelocity</string>
			<key>default</key><real>0.6</real>
			<key>min</key><real>0</real>
			<key>max</key><real>2</real>
			<key>showValue</key><true/>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>果冻压扁</string>
			<key>key</key><string>jelly</string>
			<key>default</key><true/>
		</dict>
		<dict>
			<key>cell</key><string>PSSliderCell</string>
			<key>label</key><string>果冻幅度</string>
			<key>key</key><string>jellyAmount</string>
			<key>default</key><real>0.06</real>
			<key>min</key><real>0</real>
			<key>max</key><real>0.15</real>
			<key>showValue</key><true/>
		</dict>

		<!-- ============ 停留 / 收起 ============ -->
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>停留与收起</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSliderCell</string>
			<key>label</key><string>停留时长</string>
			<key>key</key><string>holdSeconds</string>
			<key>default</key><real>3.6</real>
			<key>min</key><real>1</real>
			<key>max</key><real>8</real>
			<key>showValue</key><true/>
		</dict>
		<dict>
			<key>cell</key><string>PSSliderCell</string>
			<key>label</key><string>收起时长</string>
			<key>key</key><string>exitDuration</string>
			<key>default</key><real>0.16</real>
			<key>min</key><real>0.08</real>
			<key>max</key><real>0.5</real>
			<key>showValue</key><true/>
		</dict>
		<dict>
			<key>cell</key><string>PSSliderCell</string>
			<key>label</key><string>收起上移</string>
			<key>key</key><string>exitLift</string>
			<key>default</key><real>-22</real>
			<key>min</key><real>-50</real>
			<key>max</key><real>-4</real>
			<key>showValue</key><true/>
		</dict>

		<!-- ============ 重置 ============ -->
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>关于</string>
			<key>footerText</key><string>微信 TG 风格消息弹窗 · 默认参数取自 Telegram 弹窗动画的逐帧量测。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSButtonCell</string>
			<key>label</key><string>恢复默认设置</string>
			<key>action</key><string>resetDefaults:</string>
		</dict>

	</array>
</dict>
</plist>
